rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Check if the user is an admin
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // USER DATA
    match /users/{userId} {
      // Users may create only a standard profile and may never grant themselves a role.
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.role == "user"
                    && request.resource.data.keys().hasOnly(['email', 'role', 'username', 'createdAt', 'photoURL', 'provider']);
      allow read: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.role == resource.data.role
                    && request.resource.data.email == resource.data.email
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username', 'photoURL']);
      allow delete: if request.auth != null && request.auth.uid == userId;
      // Admin can read all users (needed for Dashboard "Total Users")
      allow read, write: if isAdmin();
    }

    // INVENTORY DATA: Publicly readable, strictly Admin writable
    match /books/{bookId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /courses/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /universities/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Explicitly allow collectionGroup queries for questions and questionPdfs
    match /{path=**}/questions/{question} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /{path=**}/questionPdfs/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ANALYTICS TRACKING
    match /stats/{statId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /daily_stats/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // CLIENT ERROR LOGGING: Authenticated clients may log only bounded errors for themselves.
    match /client_errors/{errorId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.userEmail == request.auth.token.email
                    && request.resource.data.keys().hasOnly(['message', 'stack', 'componentStack', 'type', 'url', 'userAgent', 'userId', 'userEmail', 'resolved', 'date', 'timestamp', 'createdAt'])
                    && request.resource.data.message is string
                    && request.resource.data.message.size() <= 1000
                    && request.resource.data.stack is string
                    && request.resource.data.stack.size() <= 2000
                    && request.resource.data.componentStack is string
                    && request.resource.data.componentStack.size() <= 2000
                    && request.resource.data.url is string
                    && request.resource.data.url.size() <= 500;
      allow read, update, delete: if isAdmin();
    }
  }
}
